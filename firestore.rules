rules_version = '2';

// Everything is locked until the dashboard's sign-in and roles are built.
// Attendee check-in runs on the server with the Admin SDK, which bypasses these
// rules, so browsers never need read access to attendees.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
