rules_version = '2';

// Assumed data model
//
// waitlist/{entryId}   Product waitlist from the marketing site (apps/web), auto IDs.
//   email: string    required, lowercase
//   createdAt: timestamp   required, set by the server (serverTimestamp())
//
// Signing up twice adds a second entry; dedupe by email when exporting.
//
// Browsers can only add an entry. Nobody can read, change or delete an entry
// from a browser; organisers read the list in the Firebase console.
//
// Everything else is locked until the dashboard's sign-in and roles are built.
// Attendee check-in runs on the server with the Admin SDK, which bypasses these
// rules, so browsers never need read access to attendees.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Same pattern as EMAIL_PATTERN in apps/web/src/lib/waitlist.ts; keep them in step.
    function isValidWaitlistEntry() {
      let data = request.resource.data;
      return data.keys().hasOnly(['email', 'createdAt'])
        && data.email is string
        && data.email == data.email.lower()
        && data.email.size() <= 254
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.createdAt == request.time;
    }

    match /waitlist/{entryId} {
      allow create: if isValidWaitlistEntry();
    }
  }
}
