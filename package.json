{
  "name": "checkpad",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @checkpad/web",
    "dev:dashboard": "npm run dev -w @checkpad/dashboard",
    "build": "npm run build --workspaces --if-present"
  }
}
