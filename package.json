{
  "name": "checkpad",
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @checkpad/web",
    "dev:dashboard": "npm run dev -w @checkpad/dashboard",
    "build": "npm run build --workspaces --if-present",
    "test:dashboard": "npm test -w @checkpad/dashboard",
    "release": "node scripts/release.mjs"
  }
}
