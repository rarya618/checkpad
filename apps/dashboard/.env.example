# Copy to .env.local and fill in from the checkpad-app "Checkpad Dashboard" web app:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <app id> --project checkpad-app
# except the auth domain: use manage.checkpad.app, not the SDK config's checkpad-app.firebaseapp.com,
# so Google sign-in shows Checkpad's domain and Safari treats sign-in as first-party.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=manage.checkpad.app
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: base URL of the attendee check-in site (apps/web).
# Defaults to http://localhost:4321 in dev and https://checkpad.app in builds.
# VITE_WEB_URL=

# Optional: Google One Tap on the sign-in page (src/lib/googleOneTap.ts). The Firebase console's
# Authentication → Sign-in method → Google → Web SDK configuration → Web client ID. In Google
# Cloud's Credentials, that client's Authorized JavaScript origins need https://manage.checkpad.app
# (and http://localhost:5173 to try it with npm run dev:dashboard).
# VITE_GOOGLE_CLIENT_ID=

# Optional: Sentry error tracking, sent from production builds only (src/lib/errorTracking.ts).
# The Checkpad dashboard project's DSN:
# VITE_SENTRY_DSN=
