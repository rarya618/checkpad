# Copy to .env.local and fill in from the checkpad-app "Checkpad Dashboard" web app:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <app id> --project checkpad-app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: base URL of the attendee check-in site (apps/web).
# Defaults to http://localhost:4321 in dev and https://checkpad.app in builds.
# VITE_WEB_URL=
