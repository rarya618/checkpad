# Copy to .env.local and fill in from the checkpad-app "Checkpad Dashboard" web app
# (the same values as the dashboard's VITE_FIREBASE_*), used by the waitlist form:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <app id> --project checkpad-app
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Optional: Google Analytics for the marketing page, sent from production builds only
# (src/components/marketing/Analytics.astro). The checkpad-app web app's measurementId:
# PUBLIC_GA_MEASUREMENT_ID=

# Optional: base URL of the organiser dashboard (apps/dashboard).
# Defaults to http://localhost:5173 in dev and https://checkpad-app.web.app in builds.
# PUBLIC_DASHBOARD_URL=
