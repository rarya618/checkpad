---
import { Font } from 'astro:assets';
import ErrorTracking from '../components/ErrorTracking.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	/** Keep the page out of search results (check-in and team links). */
	noindex?: boolean;
	/** The page's Markdown copy, for agents and LLMs (docs pages). */
	markdown?: string;
}

const { title, description, noindex = false, markdown } = Astro.props;
// Check-in and team links are rewrites, so their own URL isn't the page's; they're noindex anyway
const canonical = noindex ? undefined : new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-jakarta" preload />
		<Font cssVariable="--font-geist-mono" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex" />}
		{canonical && <link rel="canonical" href={canonical} />}
		{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
		<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
		<slot name="head" />
		<ErrorTracking />
	</head>
	<body class="bg-off-white font-sans text-dark-blue antialiased">
		<slot />
	</body>
</html>
