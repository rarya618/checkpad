---
import Footer from '../components/marketing/Footer.astro';
import Nav from '../components/marketing/Nav.astro';
import Layout from '../layouts/Layout.astro';

// Not in Figma. Keep it true to the code: what each part of Checkpad stores is in
// firestore.rules, and analytics is in components/marketing/Analytics.astro. Update the date
// whenever the substance changes. "privacy" is a reserved event link (RESERVED_SLUGS).
const updated = '25 October 2026';
/** Where people send privacy requests. Production builds fail until it's set. */
const contact = 'hello@russal.dev';
/** Who runs Checkpad, as it should appear in "Checkpad is run by …". */
const operator = '';
if (import.meta.env.PROD && !contact) throw new Error('Set the contact email in src/pages/privacy.astro before building for production.');

const email = contact || '[contact email]';

/** A section's body: paragraphs, and bulleted lists where it's a run of things we store. */
type Block = string | { list: string[] };

const sections: { title: string; body: Block[] }[] = [
	{
		title: 'If you join the waitlist',
		body: [
			'We store your email address and when you signed up. We only use it to tell you when you can set up your first event.',
			'It stays on the list until you ask us to remove it.',
		],
	},
	{
		title: 'If you check in at an event',
		body: [
			'The event’s organiser imports their attendee list from where you registered, such as Bevy. For that event, Checkpad then holds:',
			{
				list: [
					'your name, email address, ticket number and ticket type, from that list',
					'when you checked in, and which volunteer checked you in if one did',
					'if you weren’t on the list, the name and email address you give as a walk-in',
				],
			},
			'The event’s organisers and volunteers can see this. They use it to check people in, count who came, run the prize draw and report attendance back to their registration platform.',
			'The organiser decides how long their event stays in Checkpad. Deleting an event deletes its attendee list. For questions about a particular event, contact its organiser.',
		],
	},
	{
		title: 'If you’re an organiser or volunteer',
		body: [
			'We store your email address, name, role and team, who invited you and when you last signed in. You sign in with Google or with a link we email you.',
		],
	},
	{
		title: 'Analytics',
		body: [
			'Checkpad’s home page uses Google Analytics to count visits and waitlist signups. Google Analytics sets cookies in your browser. It never receives your email address.',
			'If you visit from the European Economic Area, the United Kingdom or Switzerland, Google Analytics doesn’t set cookies for you.',
			'Event check-in pages and the organiser dashboard don’t use analytics.',
		],
	},
	{
		title: 'Where it’s stored',
		body: [
			'Checkpad runs on Google Firebase, with the database in Sydney. Firebase Authentication handles sign-in, and Resend sends our emails. Some of these services process data outside Australia.',
			'We don’t sell your information or use it for advertising.',
		],
	},
];

const text = 'text-base leading-7 text-dark-blue/85 xl:text-lg xl:leading-8';
---

<Layout title="Privacy · Checkpad" description="What Checkpad stores about waitlist signups, event attendees and organisers, and how to have it removed.">
	<Nav />
	<main>
		<article class="mx-auto flex w-full max-w-[760px] flex-col gap-10 px-6 pt-10 pb-18 md:px-12 xl:pt-16 xl:pb-30">
			<header class="flex flex-col gap-3">
				<h1 class="font-display text-5xl xl:text-6xl">Privacy</h1>
				<p class="text-lg text-dark-blue/85 xl:text-xl">
					What Checkpad stores, who sees it and how to have it removed.{operator && ` Checkpad is run by ${operator}.`}
				</p>
				<p class="text-base text-med-blue">Last updated {updated}</p>
			</header>
			{sections.map((s) => (
				<section class="flex flex-col gap-3">
					<h2 class="font-display text-2xl">{s.title}</h2>
					{s.body.map((block) =>
						typeof block === 'string' ? (
							<p class={text}>{block}</p>
						) : (
							<ul class={`${text} flex list-disc flex-col gap-1.5 pl-6`}>
								{block.list.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						),
					)}
				</section>
			))}
			<section class="flex flex-col gap-3">
				<h2 class="font-display text-2xl">Seeing, changing or removing your information</h2>
				<p class={text}>
					Email <a href={`mailto:${email}`} class="font-semibold text-med-blue underline">{email}</a> to ask what we hold about you, to
					correct it or to have it removed. If it’s about a particular event, we may pass your request to its organiser.
				</p>
			</section>
			<section class="flex flex-col gap-3">
				<h2 class="font-display text-2xl">Changes</h2>
				<p class={text}>
					If what we store changes, we’ll update this page and its date.
				</p>
			</section>
		</article>
	</main>
	<Footer />
</Layout>
