---
// One docs topic (lib/docs.ts), with previous and next at the foot so the guide reads in order.
import DocsBody from '../../components/docs/DocsBody.astro';
import DocsLayout from '../../components/docs/DocsLayout.astro';
import { PAGES, type DocsPage } from '../../lib/docs';

export function getStaticPaths() {
	return PAGES.map((page, i) => ({ params: { slug: page.slug }, props: { page, previous: PAGES[i - 1], next: PAGES[i + 1] } }));
}

interface Props {
	page: DocsPage;
	previous?: DocsPage;
	next?: DocsPage;
}

const { page, previous, next } = Astro.props;
---

<DocsLayout title={`${page.title} · Checkpad docs`} description={page.description} current={page.slug} markdown={`/docs/${page.slug}.md`}>
	<article class="flex flex-col gap-6">
		<h1 class="self-start font-display text-4xl xl:text-5xl">{page.title}</h1>
		<DocsBody page={page} />
	</article>

	<nav aria-label="Previous and next" class="mt-14 grid gap-4 border-t border-light-blue pt-8 sm:grid-cols-2 xl:mt-16">
		{previous && (
			<a href={`/docs/${previous.slug}`} rel="prev" class="flex flex-col gap-1 rounded-xl border border-dark-blue/12 bg-white px-5 py-4 transition-colors hover:border-med-blue">
				<span class="flex items-center gap-1 text-sm font-semibold tracking-tight text-med-blue"><svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5m7 7-7-7 7-7" /></svg>Previous</span>
				<span data-docs-title class="text-lg font-bold tracking-tight">{previous.title}</span>
			</a>
		)}
		{next && (
			<a href={`/docs/${next.slug}`} rel="next" class="flex flex-col gap-1 rounded-xl border border-dark-blue/12 bg-white px-5 py-4 text-right transition-colors hover:border-med-blue sm:col-start-2">
				<span class="flex items-center justify-end gap-1 text-sm font-semibold tracking-tight text-med-blue">Next<svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7" /></svg></span>
				<span data-docs-title class="self-end text-lg font-bold tracking-tight">{next.title}</span>
			</a>
		)}
	</nav>
</DocsLayout>
