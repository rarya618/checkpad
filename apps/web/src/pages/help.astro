---
import Footer from '../components/marketing/Footer.astro';
import Nav from '../components/marketing/Nav.astro';
import Layout from '../layouts/Layout.astro';
import { HELP_SECTIONS as sections } from '../lib/help';

// Not in Figma. Help for attendees; its words are in lib/help.ts.
// "help" is a reserved event link (RESERVED_SLUGS).

const text = 'text-base leading-7 text-dark-blue/85 xl:text-lg xl:leading-8';
---

<Layout title="Help checking in · Checkpad" markdown="/help.md" description="How to check in at an event with Checkpad, and what to do if you’re not on the list.">
	<Nav />
	<main>
		<article class="mx-auto flex w-full max-w-[760px] flex-col gap-10 px-6 pt-10 pb-18 md:px-12 xl:pt-16 xl:pb-30">
			<header class="flex flex-col gap-3">
				<h1 class="font-display text-5xl xl:text-6xl">Help checking in</h1>
				<p class="text-lg text-dark-blue/85 xl:text-xl">
					For people checking in at an event. Running one?{' '}
					<a href="/docs" class="font-semibold text-med-blue underline">The docs are for organisers</a>.
				</p>
			</header>
			{sections.map((s) => (
				<section id={s.id} class="flex flex-col gap-3">
					<h2 class="font-display text-2xl">{s.title}</h2>
					{s.body.map((block) =>
						typeof block === 'string' ? (
							<p class={text}>{block}</p>
						) : (
							<ul class={`${text} flex list-disc flex-col gap-1.5 pl-6`}>
								{block.list.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						),
					)}
				</section>
			))}
			<p class={text}>
				<a href="/privacy" class="font-semibold text-med-blue underline">Read the privacy policy</a>
			</p>
		</article>
	</main>
	<Footer />
</Layout>
