---
import { Image } from 'astro:assets';
import { buttonClass } from '@checkpad/shared/button';
import attendeesDashboard from '../assets/screens/attendees-dashboard.png';
import checkedInPhone from '../assets/screens/checked-in-phone.png';
import eventAnalytics from '../assets/screens/event-analytics.png';
import staffCheckIn from '../assets/screens/staff-check-in.png';
import Footer from '../components/marketing/Footer.astro';
import Icon, { type IconName } from '../components/marketing/Icon.astro';
import Nav from '../components/marketing/Nav.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import Showcase from '../components/marketing/Showcase.astro';
import WaitlistForm from '../components/marketing/WaitlistForm';
import Layout from '../layouts/Layout.astro';

// Copy and layout follow the Figma "Marketing site – desktop" and "– mobile" frames.
const steps: { icon: IconName; title: string; body: string }[] = [
	{ icon: 'upload', title: 'Import your list', body: 'Upload the attendee CSV from Bevy. Checkpad matches people by ticket number, so you can import again when more register.' },
	{ icon: 'qr-code', title: 'Put the QR at the door', body: 'Show the venue QR on a screen or a printed sign. Attendees scan it and type their email.' },
	{ icon: 'activity', title: 'Watch arrivals live', body: 'Your dashboard counts who’s in, who hasn’t arrived yet and how many walk-ins you’ve had.' },
];

const features: { icon: IconName; title: string; body: string }[] = [
	{ icon: 'smartphone', title: 'Self check-in on their phone', body: 'Attendees scan the QR with their phone camera and type their email. The confirmation shows their ticket number.' },
	{ icon: 'user-check', title: 'Staff check-in and walk-ins', body: 'Look someone up from a laptop or phone, or add a walk-in with a ticket on the spot.' },
	{ icon: 'layout-dashboard', title: 'A live dashboard', body: 'See who’s arrived, undo a mistake and search the list while the room fills up.' },
	{ icon: 'gift', title: 'Prize draw on the projector', body: 'Draw winners from everyone checked in. The projector shows names only, and nobody wins twice.' },
	{ icon: 'bar-chart', title: 'Analytics', body: 'Arrivals every 15 minutes, turnout by ticket type and trends across your events.' },
	{ icon: 'users', title: 'Teams and organisers', body: 'Give each chapter a permanent check-in link and share events with co-organisers.' },
];

// Groups running their meetups on gdg-check-in, the app Checkpad replaces. Names only:
// their logos need approval from Google first.
const usedBy = ['GDG Sydney', 'GDG UTS'];

// Only Bevy's CSV import is built. Keep the others marked as planned until they ship.
const platforms: { name: string; supported: boolean }[] = [
	{ name: 'Bevy', supported: true },
	{ name: 'Eventbrite', supported: false },
	{ name: 'Humanitix', supported: false },
	{ name: 'Luma', supported: false },
	{ name: 'Meetup', supported: false },
	{ name: 'Any CSV file', supported: false },
];

const venueNeeds: { icon: IconName; title: string; body: string }[] = [
	{ icon: 'qr-code', title: 'A screen or a printed sign', body: 'Show the QR code on a TV or projector, or download it as a PNG and print it.' },
	{ icon: 'smartphone', title: 'Attendees’ own phones', body: 'They scan with the camera or type the short link, over mobile data or the venue’s Wi-Fi.' },
	{ icon: 'layout-dashboard', title: 'A laptop or phone for staff', body: 'Look people up and add walk-ins from either one, in the browser.' },
];

const container = 'mx-auto w-full max-w-[1440px] px-6 md:px-12 xl:px-30';
---

<Layout
	title="Checkpad · Self check-in for community meetups"
	description="Attendees check themselves in at your meetup with a QR code and their email. You track arrivals and walk-ins on a dashboard. Join the waitlist."
>
	<Nav />
	<main>
		<!-- Hero -->
		<section class="overflow-hidden">
			<div class="mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-6 pt-6 md:px-12 pb-18 xl:min-h-[min(calc(100svh-var(--header-height)),900px)] xl:flex-row xl:items-center xl:gap-16 xl:pt-6 xl:pr-0 xl:pb-24 xl:pl-30">
				<div class="flex flex-col gap-8 xl:mb-10 xl:w-[540px] xl:shrink-0 xl:gap-7">
					<p class="self-start rounded-full bg-light-blue px-3.5 py-1.5 text-[15px] leading-[22px] font-medium xl:px-4 xl:text-base xl:leading-6">
						For community event organisers
					</p>
					<div class="flex flex-col gap-4 xl:gap-7">
						<h1 class="font-display text-[44px] leading-[53px] xl:text-[68px] xl:leading-[82px]">Attendees check themselves in.</h1>
						<p class="text-lg leading-[27px] text-dark-blue/85 xl:text-[21px] xl:leading-8">
							They scan a QR code when they arrive and type their email. You watch the room fill up from your laptop or phone.
						</p>
					</div>
					<div class="flex flex-wrap gap-3">
						<a href="#waitlist" class={buttonClass('primary')}>Join the waitlist</a>
						<a href="#how-it-works" class={buttonClass('secondary')}>See how it works</a>
					</div>
				</div>
				<div
					class="relative h-[400px] shrink-0 overflow-hidden rounded-3xl bg-light-blue md:h-[500px] xl:h-[600px] xl:w-[760px] xl:overflow-visible xl:rounded-none xl:bg-transparent"
				>
					<Image
						src={attendeesDashboard}
						alt="The Attendees dashboard showing 41 people checked in"
						widths={[560, 800, 1120, 1600]}
						sizes="(min-width: 768px) 800px, 560px"
						loading="eager"
						class="absolute top-8 left-[120px] w-[560px] max-w-none rounded-xl md:top-12 md:left-[200px] md:w-[800px] shadow-[0_12px_32px_rgb(17_45_78/0.12)] xl:top-0 xl:left-20 xl:w-[800px] xl:rounded-2xl xl:border xl:border-light-blue xl:shadow-[0_24px_64px_rgb(17_45_78/0.16)]"
					/>
					<Image
						src={checkedInPhone}
						alt="An attendee’s phone showing “You’re checked in”"
						widths={[210, 420]}
						sizes="(min-width: 768px) 210px, 168px"
						loading="eager"
						class="absolute top-[52px] left-8 w-[168px] rounded-3xl border-[5px] border-dark-blue md:top-20 md:left-16 md:w-[210px] md:border-[6px] shadow-[0_16px_36px_rgb(17_45_78/0.22)] xl:top-[190px] xl:left-0 xl:w-[210px] xl:rounded-[28px] xl:border-[6px] xl:shadow-[0_24px_48px_rgb(17_45_78/0.22)]"
					/>
				</div>
			</div>
		</section>

		<!-- Used by -->
		<section aria-labelledby="used-by">
			<div class={`${container} flex flex-col gap-3 pb-18 md:flex-row md:items-baseline md:gap-6 xl:pb-24`}>
				<h2 id="used-by" class="text-base leading-6 font-semibold text-med-blue xl:text-[17px] xl:leading-[26px]">Used by</h2>
				<ul class="flex flex-wrap gap-x-8 gap-y-1">
					{usedBy.map((name) => (
						<li class="font-display text-2xl leading-[1.5] xl:text-[28px] xl:leading-[1.2]">{name}</li>
					))}
				</ul>
			</div>
		</section>

		<!-- How it works -->
		<section id="how-it-works" class="bg-white">
			<div class={`${container} flex flex-col gap-8 py-18 xl:gap-14 xl:py-30`}>
				<SectionHeader eyebrow="How it works" title="Three steps from your Bevy list to check-in." />
				<ol class="grid gap-10 lg:grid-cols-3">
					{steps.map((s, i) => (
						<li class="flex flex-col gap-4">
							<div class="flex items-center gap-4">
								<span class="grid size-14 place-items-center rounded-[14px] bg-off-white">
									<Icon name={s.icon} />
								</span>
								<span class="font-mono text-base leading-6 text-med-blue">{String(i + 1).padStart(2, '0')}</span>
							</div>
							<h3 class="text-[22px] leading-[33px] font-semibold">{s.title}</h3>
							<p class="text-[17px] leading-[26px] text-dark-blue/85">{s.body}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<!-- Features -->
		<section id="features">
			<div class={`${container} flex flex-col gap-8 py-18 xl:gap-14 xl:py-30`}>
				<SectionHeader
					eyebrow="Features"
					title="Everything for meetup night."
					subtitle="From the first scan to the last walk-in of the night."
					center
				/>
				<ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 xl:gap-10">
					{features.map((f) => (
						<li class="flex flex-col gap-4 rounded-[20px] border-[1.5px] border-light-blue bg-white p-8">
							<span class="grid size-14 place-items-center rounded-[14px] bg-light-blue">
								<Icon name={f.icon} />
							</span>
							<h3 class="text-[22px] leading-[33px] font-semibold">{f.title}</h3>
							<p class="text-[17px] leading-[26px] text-dark-blue/85">{f.body}</p>
						</li>
					))}
				</ul>
			</div>
		</section>

		<Showcase
			id="walk-ins"
			class="bg-light-blue"
			eyebrow="Walk-ins"
			title="Walk-ins get a ticket too."
			body="Staff look people up by email or ticket number from a laptop or phone. Anyone who didn’t register gets the next walk-in ticket and is checked in on the spot."
			points={['Tickets count up from GDGWALKIN0001', 'Walk-ins show separately in your counts', 'Choose per event if attendees can add themselves']}
			image={staffCheckIn}
			imageAlt="The staff Check in page offering to add an unregistered email as walk-in GDGWALKIN0005"
		/>

		<Showcase
			id="analytics"
			eyebrow="Analytics"
			title="Know how the night went."
			body="See when people arrived, how many walk-ins you had and how turnout compares across your events."
			points={['Arrivals every 15 minutes', 'Turnout by ticket type', 'Trends across every event']}
			image={eventAnalytics}
			imageAlt="Event analytics with arrivals every 15 minutes and turnout by ticket type"
			reverse
		/>

		<!-- Supported platforms and venues -->
		<section class="bg-white">
			<div class={`${container} grid gap-18 py-18 xl:grid-cols-2 xl:gap-20 xl:py-30`}>
				<div id="platforms" class="flex scroll-mt-(--header-height) flex-col gap-8">
					<SectionHeader
						eyebrow="Supported platforms"
						title="Bring your attendee list from Bevy."
						subtitle="Export the attendee CSV from Bevy and import it before the event. Imports from other platforms are planned."
					/>
					<ul class="flex flex-col">
						{platforms.map((p) => (
							<li class="flex items-center justify-between gap-4 border-b border-light-blue py-4 first:border-t">
								<span class="text-lg leading-[27px] font-semibold">{p.name}</span>
								<span
									class:list={[
										'rounded-full px-3 py-1 text-sm leading-[21px] font-semibold',
										p.supported ? 'bg-dark-blue text-off-white' : 'bg-light-blue text-dark-blue',
									]}
								>
									{p.supported ? 'Supported' : 'Planned'}
								</span>
							</li>
						))}
					</ul>
				</div>
				<div id="venues" class="flex scroll-mt-(--header-height) flex-col gap-8">
					<SectionHeader
						eyebrow="Supported venues"
						title="Any venue where attendees can get online."
						subtitle="Checkpad runs in the browser, so a venue only needs three things."
					/>
					<ul class="flex flex-col gap-6">
						{venueNeeds.map((v) => (
							<li class="flex gap-4">
								<span class="grid size-14 shrink-0 place-items-center rounded-[14px] bg-light-blue">
									<Icon name={v.icon} />
								</span>
								<div class="flex flex-col gap-1">
									<h3 class="text-xl leading-[30px] font-semibold">{v.title}</h3>
									<p class="text-[17px] leading-[26px] text-dark-blue/85">{v.body}</p>
								</div>
							</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<!-- Call to action -->
		<section id="waitlist">
			<div class={`${container} pt-2 pb-18 xl:pt-10 xl:pb-30`}>
				<div class="flex flex-col items-center gap-4 rounded-3xl bg-dark-blue px-7 py-12 text-center xl:gap-6 xl:rounded-[32px] xl:px-20 xl:py-22">
					<h2 class="font-display text-[32px] leading-[38px] text-off-white xl:text-[52px] xl:leading-[62px]">Use Checkpad at your next meetup.</h2>
					<p class="text-[17px] leading-[26px] text-light-blue xl:text-xl xl:leading-[30px]">
						Checkpad is opening to more organisers soon. Leave your email and we’ll let you know when you can set up your first event.
					</p>
					<div class="mt-2 flex w-full justify-center xl:mt-4">
						<WaitlistForm client:visible />
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
