---
import { Image } from 'astro:assets';
import attendeesDashboard from '../assets/screens/attendees-dashboard.png';
import checkInPhone from '../assets/screens/check-in-phone.png';
import eventAnalytics from '../assets/screens/event-analytics.png';
import staffCheckIn from '../assets/screens/staff-check-in.png';
import staffCheckInPhone from '../assets/screens/staff-check-in-phone.png';
import Analytics from '../components/marketing/Analytics.astro';
import Footer from '../components/marketing/Footer.astro';
import Icon from '../components/marketing/Icon.astro';
import Nav from '../components/marketing/Nav.astro';
import WaitlistForm from '../components/marketing/WaitlistForm';
import Layout from '../layouts/Layout.astro';

// The category-standard product page (apps/web/.impeccable/surfaces/src-pages-index-astro.md):
// the offer and the waitlist up top with the product working under it, then how it works, one
// feature grid, what a venue needs, and the close.
const steps: { title: string; body: string }[] = [
	{ title: 'Import your list', body: 'Upload the attendee CSV from Bevy or Luma. Checkpad matches people by ticket number, so you can import again when more register.' },
	{ title: 'Put the QR at the door', body: 'Show the venue QR on a screen or a printed sign. Attendees scan it and type their email.' },
	{ title: 'Watch arrivals live', body: 'Your dashboard counts who’s in, who hasn’t arrived yet and how many walk-ins you’ve had.' },
];

// Under the feature grid, as a quiet list
const extras: { title: string; body: string }[] = [
	{ title: 'Prize draw on the projector', body: 'Draw winners from everyone checked in. The projector shows names only, and nobody wins twice.' },
	{ title: 'Teams and organisers', body: 'A permanent check-in link for each group, co-organisers, and volunteers who can check people in without changing the event.' },
];

// Bevy's and Luma's CSV imports are built. Keep the others marked as planned until they ship.
const supported = ['Bevy', 'Luma'];
const planned = ['Eventbrite', 'Humanitix', 'Meetup', 'Any CSV file'];

const venueNeeds: { title: string; body: string }[] = [
	{ title: 'A screen or a printed sign', body: 'Show the QR on a TV or projector, or print it.' },
	{ title: 'Attendees’ own phones', body: 'They scan with the camera or type the short link, on mobile data or the venue’s Wi-Fi.' },
	{ title: 'A laptop or phone for staff', body: 'Look people up and add walk-ins in the browser.' },
];

const container = 'mx-auto w-full max-w-[1280px] px-6 md:px-12';
const frame = 'rounded-2xl border border-light-blue bg-white shadow-[0_24px_60px_-12px_rgb(17_45_78/0.18)]';
const tile = 'flex flex-col overflow-hidden rounded-3xl border shadow-[0_16px_40px_-16px_rgb(17_45_78/0.2)]';
// A screenshot cropped into one corner of a tile, zoomed on the part the tile is about
const crop = 'relative overflow-hidden rounded-tl-2xl border-t border-l border-light-blue';
---

<Layout
	title="Checkpad · Self check-in for community meetups"
	description="Attendees check themselves in at your meetup with a QR code and their email. You track arrivals and walk-ins on a dashboard. Join the waitlist."
>
	<Analytics slot="head" />
	<Nav />
	<main>
		<!-- Hero: the offer and the waitlist, then the product at work -->
		<section class="relative overflow-hidden">
			<div class={`${container} flex flex-col items-center gap-6 pt-10 text-center md:pt-14 xl:pt-12`}>
				<h1 data-intro class="max-w-4xl font-display text-5xl text-balance md:text-6xl xl:text-7xl">Attendees check themselves in</h1>
				<p data-intro style="--reveal-delay: 80ms" class="max-w-2xl text-lg text-pretty text-dark-blue/80 xl:text-xl">
					They scan a QR code when they arrive and type their email. You watch the room fill up from your laptop or phone.
				</p>
				<div data-intro style="--reveal-delay: 160ms" class="flex w-full flex-col items-center gap-3">
					<WaitlistForm tone="light" client:load />
					<p class="text-sm text-dark-blue/70">Imports attendee lists from Bevy and Luma. Not open to new organisers yet.</p>
				</div>
			</div>

			<!-- The product on a light-blue band that starts halfway down the dashboard -->
			<div class="relative mt-10 xl:mt-12">
				<div aria-hidden="true" class="absolute inset-x-0 top-1/2 bottom-0 bg-light-blue"></div>
				<div class={`${container} relative pb-14 xl:pb-20`}>
					<div class="relative mx-auto max-w-[1080px]">
						<!-- On phones, cropped to the count so the phone and the arrival have room -->
						<div data-intro="dashboard" class={`overflow-hidden ${frame}`}>
							<Image
								src={attendeesDashboard}
								alt="The Attendees dashboard showing 41 people checked in"
								widths={[640, 960, 1280, 1600]}
								sizes="(min-width: 1180px) 1080px, 140vw"
								loading="eager"
								class="aspect-[4/3] w-full origin-[97%_100%] scale-[1.3] object-cover md:aspect-auto md:scale-100"
							/>
						</div>
						<!-- The attendee's phone, cropped to its form; on phones it sits bottom right, clear of the count -->
						<div
							data-intro="phone"
							class="absolute -right-1 -bottom-8 w-[40%] max-w-[230px] rounded-4xl border-[5px] border-dark-blue bg-off-white p-0.5 shadow-[0_24px_48px_-8px_rgb(17_45_78/0.35)] md:top-[25.5%] md:right-auto md:bottom-auto md:-left-8 md:w-[30%] md:border-[6px] md:p-1 xl:-left-16"
						>
							<Image
								src={checkInPhone}
								alt="An attendee’s phone showing the check-in form"
								widths={[230, 460, 690]}
								sizes="(min-width: 768px) 230px, 40vw"
								loading="eager"
								class="aspect-[9/14] w-full rounded-3xl object-cover object-bottom"
							/>
						</div>
						<!-- A sample arrival beside the dashboard's count -->
						<p
							data-intro="arrival"
							aria-hidden="true"
							class="absolute -top-5 left-2 flex items-center gap-2 rounded-xl bg-dark-blue py-2 pr-3 pl-2 text-left text-off-white shadow-[0_16px_40px_-8px_rgb(17_45_78/0.45)] md:top-[35.5%] md:right-auto md:left-[44%] md:gap-3 md:rounded-2xl md:py-3 md:pr-5 md:pl-3"
						>
							<span class="grid size-7 place-items-center rounded-full bg-med-blue md:size-9">
								<Icon name="check" size={18} strokeWidth={3} />
							</span>
							<span class="flex flex-col">
								<span class="text-sm font-semibold md:text-base">Jane Doe checked in</span>
								<span class="text-xs text-light-blue md:text-sm">Just now · 19:32</span>
							</span>
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- How it works -->
		<section id="how-it-works">
			<div class={`${container} flex flex-col gap-10 py-20 xl:gap-14 xl:py-28`}>
				<h2 data-reveal class="max-w-3xl font-display text-3xl text-balance xl:text-5xl">From your attendee list to a door with no queue</h2>
				<ol class="grid gap-8 md:grid-cols-3 md:gap-10">
					{steps.map((s, i) => (
						<li data-reveal style={`--reveal-delay: ${i * 100}ms`} class="flex flex-col gap-3 border-t-2 border-light-blue pt-6">
							<span class="font-display text-lg text-med-blue">{i + 1}</span>
							<h3 class="font-display text-xl">{s.title}</h3>
							<p class="text-base text-dark-blue/80">{s.body}</p>
							{i === 0 && (
								<ul class="mt-1 flex flex-wrap gap-2" aria-label="Import platforms">
									{supported.map((name) => (
										<li class="flex items-center gap-1.5 rounded-full bg-dark-blue px-3 py-1 text-sm font-semibold text-off-white">
											<Icon name="check" size={14} strokeWidth={3} />
											{name}
										</li>
									))}
									{planned.map((name) => (
										<li class="rounded-full bg-light-blue px-3 py-1 text-sm font-medium">
											{name} <span class="text-dark-blue/70">· planned</span>
										</li>
									))}
								</ul>
							)}
						</li>
					))}
				</ol>
			</div>
		</section>

		<!-- Features: the product in mixed-size tiles, then the smaller features as a list -->
		<section id="features">
			<div class={`${container} flex flex-col gap-10 py-20 xl:gap-14 xl:py-28`}>
				<div data-reveal class="flex max-w-3xl flex-col gap-4">
					<h2 class="font-display text-3xl text-balance xl:text-5xl">Everything for meetup night</h2>
					<p class="text-lg text-dark-blue/80 xl:text-xl">From the first scan to the last walk-in of the night.</p>
				</div>

				<div class="grid gap-4 lg:grid-cols-6 xl:gap-6">
					<!-- Walk-ins, zoomed on the "add as walk-in" card and recent check-ins -->
					<article id="walk-ins" data-reveal class={`${tile} border-light-blue bg-white lg:col-span-4`}>
						<div class="flex flex-col gap-3 p-8 xl:p-10">
							<h3 class="font-display text-2xl xl:text-3xl">Walk-ins get a ticket too</h3>
							<p class="max-w-xl text-base text-dark-blue/80 xl:text-lg">
								Staff look people up by email or ticket number. Anyone who didn’t register gets the next numbered walk-in ticket, with no repeats across devices, and shows up separately in your counts.
							</p>
						</div>
						<div class={`${crop} fade-crop mt-auto ml-8 xl:ml-10`}>
							<Image
								src={staffCheckIn}
								alt="The staff Check in page offering to add an unregistered email as walk-in CPWALKIN0005"
								widths={[960, 1280, 1600]}
								sizes="(min-width: 1024px) 1200px, 150vw"
								class="aspect-[16/8] w-full origin-[80%_84%] scale-[1.45] object-cover"
							/>
						</div>
					</article>

					<!-- Staff on a phone -->
					<article data-reveal style="--reveal-delay: 80ms" class={`${tile} border-dark-blue bg-dark-blue text-off-white lg:col-span-2`}>
						<div class="flex flex-col gap-3 p-8 xl:p-10">
							<h3 class="font-display text-2xl">Staff can use a phone too</h3>
							<p class="text-base text-light-blue">Look people up by email or ticket number and add walk-ins from a phone, in the browser.</p>
						</div>
						<div class="mt-auto flex justify-center px-8 pt-2">
							<div class="-mb-24 w-56 rounded-t-4xl border-x-[6px] border-t-[6px] border-med-blue bg-off-white p-1 pb-0 xl:w-64">
								<Image
									src={staffCheckInPhone}
									alt="The staff Check in page on a phone, with Jane Doe found and ready to check in"
									widths={[256, 420]}
									sizes="256px"
									class="w-full rounded-t-3xl"
								/>
							</div>
						</div>
					</article>

					<!-- Analytics, zoomed on the arrivals chart -->
					<article id="analytics" data-reveal class={`${tile} border-light-blue bg-white lg:col-span-6 lg:flex-row`}>
						<div class="flex flex-col gap-3 p-8 lg:w-2/5 lg:justify-center xl:p-12">
							<h3 class="font-display text-2xl xl:text-3xl">Know how the night went</h3>
							<p class="text-base text-dark-blue/80 xl:text-lg">See when people arrived, how many walk-ins you had and how turnout compares across your events.</p>
							<ul class="mt-2 flex flex-col gap-2 text-base font-medium">
								{['Arrivals every 15 minutes', 'Turnout by ticket type', 'Trends across every event'].map((p) => (
									<li class="flex items-center gap-2.5">
										<Icon name="check" size={20} strokeWidth={2.5} class="shrink-0 text-med-blue" />
										{p}
									</li>
								))}
							</ul>
						</div>
						<div class={`${crop} fade-crop ml-8 lg:mt-12 lg:w-3/5 xl:mt-14`}>
							<Image
								src={eventAnalytics}
								alt="Event analytics with arrivals every 15 minutes and turnout by ticket type"
								widths={[960, 1280, 1600]}
								sizes="(min-width: 1024px) 1200px, 150vw"
								class="aspect-[16/9] w-full origin-[69%_83%] scale-[1.6] object-cover"
							/>
						</div>
					</article>
				</div>

				<dl class="grid gap-x-10 gap-y-6 border-t border-light-blue pt-8 md:grid-cols-2">
					{extras.map((x) => (
						<div class="flex flex-col gap-1">
							<dt class="font-display text-lg">{x.title}</dt>
							<dd class="text-base text-dark-blue/80">{x.body}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<!-- What a venue needs -->
		<section id="venues" class="border-t border-light-blue">
			<div class={`${container} flex flex-col gap-10 py-20 xl:gap-12 xl:py-28`}>
				<h2 data-reveal class="max-w-3xl font-display text-3xl text-balance xl:text-5xl">Any venue where people can get online</h2>
				<dl class="grid gap-8 md:grid-cols-3 md:gap-10">
					{venueNeeds.map((v, i) => (
						<div data-reveal style={`--reveal-delay: ${i * 80}ms`} class="flex flex-col gap-2 border-t-2 border-light-blue pt-6">
							<dt class="font-display text-xl">{v.title}</dt>
							<dd class="text-base text-dark-blue/80">{v.body}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>

		<!-- Call to action -->
		<section id="waitlist">
			<div class={`${container} py-20 xl:py-28`}>
				<div data-reveal class="flex flex-col items-center gap-5 rounded-3xl bg-dark-blue px-7 py-14 text-center xl:gap-6 xl:rounded-4xl xl:px-20 xl:py-24">
					<h2 class="font-display text-3xl text-balance text-off-white xl:text-5xl">Use Checkpad at your next meetup</h2>
					<p class="max-w-2xl text-base text-light-blue xl:text-xl">
						Checkpad isn’t open to new organisers yet. Leave your email and we’ll let you know when you can set up your first event.
					</p>
					<div class="mt-2 flex w-full justify-center xl:mt-4">
						<WaitlistForm client:visible />
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	// Play each [data-reveal] element's entrance (global.css) once it scrolls into view
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.toggleAttribute('data-revealed', true);
				observer.unobserve(entry.target);
			}
		},
		{ rootMargin: '0px 0px -10% 0px' },
	);
	document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
