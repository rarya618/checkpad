---
import type { GetStaticPaths } from 'astro';
import { mockEvents, mockTeams } from '@checkpad/shared/mock-events';
import TeamLink from '../../components/TeamLink';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = (() =>
	mockTeams.map((team) => ({
		params: { team: team.slug },
		props: { team, events: mockEvents.filter((event) => event.teamSlug === team.slug) },
	}))) satisfies GetStaticPaths;

const { team, events } = Astro.props;
---

<Layout title={`Check in · ${team.name}`} noindex>
	<TeamLink client:load team={team} events={events} />
</Layout>
