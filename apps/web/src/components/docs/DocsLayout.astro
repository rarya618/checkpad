---
// The docs frame: the sidebar of every page, grouped by when an organiser needs it, beside
// the reading column. On phones the sidebar folds into "All docs pages" above the title.
// Pages and groups are in lib/docs.ts.
import Footer from '../marketing/Footer.astro';
import Nav from '../marketing/Nav.astro';
import Layout from '../../layouts/Layout.astro';
import { GROUPS, PAGES } from '../../lib/docs';

interface Props {
	title: string;
	description: string;
	/** The page being read; none on the index. */
	current?: string;
}

const { title, description, current } = Astro.props;
const groups = GROUPS.map((group) => ({ group, pages: PAGES.filter((p) => p.group === group) }));
---

<Layout title={title} description={description}>
	<Nav />
	<div class="mx-auto flex w-full max-w-[1440px] gap-16 px-6 pt-8 pb-18 md:px-12 xl:px-30 xl:pt-12 xl:pb-30">
		<aside class="hidden w-72 shrink-0 lg:block">
			<nav aria-label="Docs" class="sticky top-[calc(var(--header-height)+--spacing(6))] flex flex-col gap-6 border-r border-dark-blue/12 pr-6">
				<a
					href="/docs"
					aria-current={current ? undefined : 'page'}
					class="block rounded-lg px-3 py-1.5 text-base font-semibold tracking-tight transition-colors hover:bg-light-blue/50 aria-[current=page]:bg-light-blue aria-[current=page]:font-bold"
				>
					Docs home
				</a>
				{groups.map(({ group, pages }) => (
					<div class="flex flex-col gap-1">
						<h2 class="px-3 text-sm font-semibold tracking-tight text-med-blue">{group}</h2>
						<ul class="flex flex-col">
							{pages.map((p) => (
								<li>
									<a
										href={`/docs/${p.slug}`}
										aria-current={p.slug === current ? 'page' : undefined}
										class="block rounded-lg px-3 py-1.5 text-base font-medium text-dark-blue/80 transition-colors hover:bg-light-blue/50 hover:text-dark-blue aria-[current=page]:bg-light-blue aria-[current=page]:font-bold aria-[current=page]:tracking-tight aria-[current=page]:text-dark-blue"
									>
										{p.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				))}
			</nav>
		</aside>

		<main class="flex max-w-[720px] min-w-0 flex-1 flex-col">
			<details class="group mb-8 rounded-xl border border-dark-blue/12 bg-white lg:hidden">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-3.5 text-base font-semibold tracking-tight [&::-webkit-details-marker]:hidden">
					All docs pages
					<svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 text-med-blue group-open:rotate-180 motion-safe:transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
				</summary>
				<nav aria-label="Docs" class="flex flex-col gap-5 border-t border-light-blue px-2 pt-4 pb-3">
					<a
						href="/docs"
						aria-current={current ? undefined : 'page'}
						class="block rounded-lg px-3 py-2.5 text-base font-semibold tracking-tight aria-[current=page]:bg-light-blue aria-[current=page]:font-bold"
					>
						Docs home
					</a>
					{groups.map(({ group, pages }) => (
						<div class="flex flex-col gap-1">
							<h2 class="px-3 text-sm font-semibold tracking-tight text-med-blue">{group}</h2>
							<ul class="flex flex-col">
								{pages.map((p) => (
									<li>
										<a
											href={`/docs/${p.slug}`}
											aria-current={p.slug === current ? 'page' : undefined}
											class="block rounded-lg px-3 py-2.5 text-base font-medium text-dark-blue/80 aria-[current=page]:bg-light-blue aria-[current=page]:font-bold aria-[current=page]:text-dark-blue"
										>
											{p.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</nav>
			</details>
			<slot />
		</main>
	</div>
	<Footer />
</Layout>
