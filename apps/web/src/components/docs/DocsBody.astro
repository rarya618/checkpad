---
// A docs page's body (lib/docs.ts): paragraphs, subheadings, numbered steps, lists, tables and tips, with the
// page's screenshot after its first paragraph.
import { Image } from 'astro:assets';
import type { DocsPage } from '../../lib/docs';

interface Props {
	page: DocsPage;
}

const { page } = Astro.props;
const text = 'text-base leading-7 text-dark-blue/85 xl:text-lg xl:leading-8';
---

<div class="flex flex-col gap-4">
	{page.body.map((block, b) => [
		typeof block === 'string' ? (
			<p class={text}>{block}</p>
		) : 'heading' in block ? (
			<h2 class="mt-6 font-display text-xl first:mt-0 xl:text-2xl">{block.heading}</h2>
		) : 'steps' in block ? (
			<ol class="flex flex-col gap-3">
				{block.steps.map((step, n) => (
					<li class="flex gap-4">
						<span class="grid size-7 shrink-0 place-items-center rounded-full bg-dark-blue text-sm font-bold text-off-white xl:mt-0.5">{n + 1}</span>
						<span class={text}>{step}</span>
					</li>
				))}
			</ol>
		) : 'list' in block ? (
			<ul class={`${text} flex list-disc flex-col gap-1.5 pl-6`}>
				{block.list.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		) : 'table' in block ? (
			// Scrolls sideways on its own on a phone, so the page doesn't
			<div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
				<table class="w-full min-w-[640px] border-collapse text-left text-sm leading-6 text-dark-blue/85 xl:text-base xl:leading-7">
					<thead>
						<tr class="border-b-2 border-light-blue">
							{block.table.head.map((label) => (
								<th scope="col" class="px-3 py-2 align-bottom font-bold text-dark-blue first:pl-0">
									{label}
								</th>
							))}
						</tr>
					</thead>
					<tbody>
						{block.table.rows.map(([label, ...cells]) => (
							<tr class="border-b border-light-blue">
								<th scope="row" class="w-1/4 py-2.5 pr-3 align-top font-semibold text-dark-blue">
									{label}
								</th>
								{cells.map((cell) => (
									<td class="px-3 py-2.5 align-top">{cell}</td>
								))}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		) : (
			<p class="rounded-2xl bg-light-blue px-5 py-4 text-base leading-7 text-dark-blue">
				<span class="font-bold">Tip: </span>
				{block.tip}
			</p>
		),
		b === 0 && page.image && (
			<Image
				src={page.image.src}
				alt={page.image.alt}
				widths={[720, 1440]}
				sizes="(min-width: 1024px) 720px, 100vw"
				class="my-2 w-full rounded-2xl border border-light-blue shadow-[0_24px_60px_-12px_rgb(17_45_78/0.18)]"
			/>
		),
	])}
</div>
