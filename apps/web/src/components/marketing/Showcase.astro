---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
	id: string;
	eyebrow: string;
	title: string;
	body: string;
	points: string[];
	image: ImageMetadata;
	imageAlt: string;
	// A phone screenshot overlapping the screenshot's bottom corner
	phone?: { src: ImageMetadata; alt: string };
	// Puts the screenshot on the left on desktop
	reverse?: boolean;
	class?: string;
}

const { id, eyebrow, title, body, points, image, imageAlt, phone, reverse = false, class: className } = Astro.props;
---

<!-- A phone runs off the bottom of the section, cropped by it -->
<section id={id} class:list={[className, phone && 'overflow-hidden']}>
	<div
		class:list={[
			'mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-6 md:px-12 xl:items-center xl:gap-20 xl:px-30',
			// Tighter with a phone, which fills the bottom of the section anyway
			phone ? 'py-14 xl:py-24' : 'py-18 xl:py-30',
			reverse ? 'xl:flex-row-reverse' : 'xl:flex-row',
		]}
	>
		<div class="flex flex-1 flex-col gap-8 xl:gap-5">
			<SectionHeader eyebrow={eyebrow} title={title} subtitle={body} />
			<ul data-reveal style="--reveal-delay: 80ms" class="flex flex-col gap-2.5 xl:gap-3 xl:pt-2">
				{points.map((p) => (
					<li class="flex items-center gap-2.5 text-base font-medium xl:gap-3 xl:text-lg">
						<Icon name="check" size={22} strokeWidth={2.5} class="shrink-0 text-med-blue" />
						{p}
					</li>
				))}
			</ul>
		</div>
		<div
			data-reveal={reverse ? 'from-left' : 'from-right'}
			style="--reveal-delay: 120ms"
			class:list={[
				// On desktop the screenshot runs into the page margin, to be bigger without squeezing the text
				'relative w-full shrink-0 md:max-w-[720px] xl:w-[760px] xl:max-w-none',
				reverse ? 'xl:-ml-30' : 'xl:-mr-30',
			]}
		>
			<Image
				src={image}
				alt={imageAlt}
				widths={[640, 960, 1280, 1520]}
				sizes="(min-width: 1280px) 760px, (min-width: 768px) 720px, 100vw"
				class="w-full rounded-2xl border border-light-blue shadow-[0_16px_40px_rgb(17_45_78/0.14)] xl:rounded-3xl"
			/>
			{
				phone && (
					// The phone's frame, with a gap around the screen; the screen's corners follow the frame's
					<div
						class:list={[
							'absolute top-2/5 w-44 rounded-4xl border-[5px] border-dark-blue bg-off-white p-0.5 shadow-[0_16px_36px_rgb(17_45_78/0.22)] md:w-64 md:border-[6px] md:p-1 xl:w-72',
							reverse ? 'left-3 md:left-6 xl:left-16' : 'right-3 md:right-6 xl:right-16',
						]}
					>
						<Image
							src={phone.src}
							alt={phone.alt}
							widths={[288, 420]}
							sizes="(min-width: 1280px) 264px, (min-width: 768px) 232px, 158px"
							class="w-full rounded-3xl"
						/>
					</div>
				)
			}
		</div>
	</div>
</section>
