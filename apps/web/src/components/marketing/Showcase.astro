---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
	id: string;
	eyebrow: string;
	title: string;
	body: string;
	points: string[];
	image: ImageMetadata;
	imageAlt: string;
	// Puts the screenshot on the left on desktop
	reverse?: boolean;
	class?: string;
}

const { id, eyebrow, title, body, points, image, imageAlt, reverse = false, class: className } = Astro.props;
---

<section id={id} class={className}>
	<div
		class:list={[
			'mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-6 py-18 lg:items-center lg:gap-20 lg:px-30 lg:py-30',
			reverse ? 'lg:flex-row-reverse' : 'lg:flex-row',
		]}
	>
		<div class="flex flex-1 flex-col gap-8 lg:gap-5">
			<SectionHeader eyebrow={eyebrow} title={title} subtitle={body} />
			<ul class="flex flex-col gap-2.5 lg:gap-3 lg:pt-2">
				{points.map((p) => (
					<li class="flex items-center gap-2.5 text-[17px] leading-[26px] font-medium lg:gap-3 lg:text-lg lg:leading-[27px]">
						<Icon name="check" size={22} strokeWidth={2.5} class="shrink-0 text-med-blue" />
						{p}
					</li>
				))}
			</ul>
		</div>
		<Image
			src={image}
			alt={imageAlt}
			widths={[640, 960, 1280]}
			sizes="(min-width: 1024px) 640px, 100vw"
			class="w-full shrink-0 rounded-xl border border-light-blue shadow-[0_16px_40px_rgb(17_45_78/0.14)] lg:w-[640px] lg:rounded-2xl"
		/>
	</div>
</section>
