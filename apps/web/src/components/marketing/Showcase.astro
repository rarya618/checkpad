---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
	id: string;
	eyebrow: string;
	title: string;
	body: string;
	points: string[];
	image: ImageMetadata;
	imageAlt: string;
	// Puts the screenshot on the left on desktop
	reverse?: boolean;
	class?: string;
}

const { id, eyebrow, title, body, points, image, imageAlt, reverse = false, class: className } = Astro.props;
---

<section id={id} class={className}>
	<div
		class:list={[
			'mx-auto flex w-full max-w-[1440px] flex-col gap-8 px-6 py-18 md:px-12 xl:items-center xl:gap-20 xl:px-30 xl:py-30',
			reverse ? 'xl:flex-row-reverse' : 'xl:flex-row',
		]}
	>
		<div class="flex flex-1 flex-col gap-8 xl:gap-5">
			<SectionHeader eyebrow={eyebrow} title={title} subtitle={body} />
			<ul data-reveal style="--reveal-delay: 80ms" class="flex flex-col gap-2.5 xl:gap-3 xl:pt-2">
				{points.map((p) => (
					<li class="flex items-center gap-2.5 text-base font-medium xl:gap-3 xl:text-lg">
						<Icon name="check" size={22} strokeWidth={2.5} class="shrink-0 text-med-blue" />
						{p}
					</li>
				))}
			</ul>
		</div>
		<Image
			src={image}
			alt={imageAlt}
			widths={[640, 960, 1280]}
			sizes="(min-width: 1280px) 640px, (min-width: 768px) 720px, 100vw"
			data-reveal={reverse ? 'from-left' : 'from-right'}
			style="--reveal-delay: 120ms"
			class="w-full shrink-0 rounded-xl border md:max-w-[720px] border-light-blue shadow-[0_16px_40px_rgb(17_45_78/0.14)] xl:w-[640px] xl:rounded-2xl"
		/>
	</div>
</section>
