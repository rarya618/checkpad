---
import { Image } from 'astro:assets';
import { buttonClass } from '@checkpad/shared/button';
import logo from '@checkpad/shared/checkpad-logo.svg';
import { DASHBOARD_URL } from '../../lib/config';
import Icon from './Icon.astro';

const links = [
	{ href: '#how-it-works', label: 'How it works' },
	{ href: '#features', label: 'Features' },
	{ href: '#prize-draw', label: 'Prize draw' },
	{ href: '#analytics', label: 'Analytics' },
];
---

<header class="mx-auto flex w-full max-w-[1440px] items-center justify-between py-5 pr-4 pl-6 lg:px-30 lg:py-7">
	<a href="/" aria-label="checkpad home">
		<Image src={logo} alt="checkpad" width={176} height={42} class="w-[134px] lg:w-[176px]" />
	</a>
	<nav aria-label="Main" class="hidden lg:block">
		<ul class="flex gap-10">
			{links.map((l) => (
				<li><a href={l.href} class="text-[17px] leading-[26px] font-medium hover:text-med-blue">{l.label}</a></li>
			))}
		</ul>
	</nav>
	<div class="hidden gap-3 lg:flex">
		<a href={DASHBOARD_URL} class={buttonClass('secondary')}>Sign in</a>
		<a href={DASHBOARD_URL} class={buttonClass('primary')}>Get started</a>
	</div>
	<button
		type="button"
		data-menu-open
		aria-label="Open menu"
		aria-haspopup="dialog"
		class="grid size-11 place-items-center rounded-[10px] lg:hidden"
	>
		<Icon name="menu" />
	</button>
</header>

<!-- Mobile menu, from the Figma "Marketing site – mobile, menu open" frame -->
<dialog
	data-menu
	aria-label="Menu"
	class="m-0 h-dvh max-h-none w-full max-w-none flex-col bg-off-white p-0 text-dark-blue open:flex lg:hidden"
>
	<div class="flex items-center justify-between py-5 pr-4 pl-6">
		<Image src={logo} alt="checkpad" width={176} height={42} class="w-[134px]" />
		<button type="button" data-menu-close aria-label="Close menu" class="grid size-11 place-items-center rounded-[10px] bg-light-blue">
			<Icon name="x" />
		</button>
	</div>
	<div class="flex flex-1 flex-col justify-between px-6 pt-4 pb-8">
		<ul>
			{links.map((l) => (
				<li>
					<a href={l.href} data-menu-link class="flex items-center justify-between border-b border-light-blue py-5">
						<span class="font-display text-[28px] leading-[34px]">{l.label}</span>
						<Icon name="chevron-right" size={24} class="text-med-blue" />
					</a>
				</li>
			))}
		</ul>
		<div class="flex flex-col gap-3">
			<a href={DASHBOARD_URL} class={`w-full ${buttonClass('primary')}`}>Get started</a>
			<a href={DASHBOARD_URL} class={`w-full ${buttonClass('secondary')}`}>Sign in</a>
			<p class="text-center text-[15px] leading-[22px] text-dark-blue/80">At an event? Scan the QR code at the venue.</p>
		</div>
	</div>
</dialog>

<script>
	const menu = document.querySelector<HTMLDialogElement>('[data-menu]')!;
	document.querySelector('[data-menu-open]')!.addEventListener('click', () => menu.showModal());
	document.querySelector('[data-menu-close]')!.addEventListener('click', () => menu.close());
	// Close before following an in-page link so the page can scroll to it
	menu.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => menu.close()));
	// The menu only exists below the lg breakpoint
	matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && menu.close());
</script>
