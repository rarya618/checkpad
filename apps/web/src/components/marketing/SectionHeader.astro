---
interface Props {
	eyebrow: string;
	title: string;
	subtitle?: string;
	center?: boolean;
}

const { eyebrow, title, subtitle, center = false } = Astro.props;
---

<div class:list={['flex flex-col gap-3 lg:gap-4', center && 'lg:items-center lg:text-center']}>
	<p class="text-base leading-6 font-semibold text-med-blue lg:text-[17px] lg:leading-[26px]">{eyebrow}</p>
	<h2 class="font-display text-[32px] leading-[38px] lg:text-[44px] lg:leading-[53px]">{title}</h2>
	{subtitle && <p class="max-w-[720px] text-lg leading-[27px] text-dark-blue/85 lg:text-xl lg:leading-[30px]">{subtitle}</p>}
</div>
