---
interface Props {
	eyebrow: string;
	title: string;
	subtitle?: string;
	center?: boolean;
}

const { eyebrow, title, subtitle, center = false } = Astro.props;
---

<div class:list={['flex flex-col gap-3 xl:gap-4', center && 'xl:items-center xl:text-center']}>
	<p class="text-base leading-6 font-semibold text-med-blue">{eyebrow}</p>
	<h2 class="font-display text-3xl text-balance xl:text-5xl">{title}</h2>
	{subtitle && <p class="max-w-[720px] text-lg text-dark-blue/85 xl:text-xl">{subtitle}</p>}
</div>
