---
import { Image } from 'astro:assets';
import logo from '@checkpad/shared/checkpad-logo.svg';
import { DASHBOARD_URL } from '../../lib/config';

const links = [
	{ href: '#how-it-works', label: 'How it works' },
	{ href: '#features', label: 'Features' },
	{ href: DASHBOARD_URL, label: 'Sign in' },
];
---

<footer class="border-t border-light-blue">
	<div
		class="mx-auto flex w-full max-w-[1440px] flex-col gap-5 px-6 pt-8 md:px-12 pb-10 xl:flex-row xl:items-center xl:justify-between xl:px-30 xl:pt-10 xl:pb-14"
	>
		<div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:gap-6">
			<Image src={logo} alt="checkpad" width={176} height={42} class="w-[134px]" />
			<p class="text-base leading-6">Made for community events.</p>
		</div>
		<ul class="flex gap-6 xl:gap-8">
			{links.map((l) => (
				<li><a href={l.href} class="text-base leading-6 font-medium hover:text-med-blue">{l.label}</a></li>
			))}
		</ul>
	</div>
</footer>
