---
import { Image } from 'astro:assets';
import logo from '@checkpad/shared/checkpad-logo.svg';
---

<!-- Small, so the form stays the main thing on the page -->
<div class="flex flex-col items-center gap-3">
	<p class="flex items-center gap-2 text-base text-med-blue">
		powered by
		<Image src={logo} alt="checkpad" width={191} height={42} class="h-6 w-auto" />
	</p>
	<!-- Attendees type their email on this page, so help and the policy are a tap away -->
	<p class="flex gap-4 text-sm text-med-blue">
		<a href="/help" class="underline">Help</a>
		<a href="/privacy" class="underline">Privacy</a>
	</p>
</div>
