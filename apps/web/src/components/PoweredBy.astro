---
import { Image } from 'astro:assets';
import logo from '@checkpad/shared/checkpad-logo.svg';
---

<div class="flex flex-col items-center gap-1.5">
	<p class="text-xl font-light text-med-blue">powered by</p>
	<Image src={logo} alt="checkpad" width={176} height={42} />
	<!-- Attendees type their email on this page, so the policy is a tap away -->
	<a href="/privacy" class="mt-3 text-base text-med-blue underline">Privacy</a>
</div>
